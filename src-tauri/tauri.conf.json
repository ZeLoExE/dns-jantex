{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS Jantex",
  "version": "4.0.2",
  "identifier": "com.jantex.dnsjantex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DNS Jantex v4.0.2",
        "url": "index.html",
        "width": 840,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/DNSChanger.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
